<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- BT6: POM Product - chạy multi class / multi method -->
<suite name="BT6 POM Product Suite">
    <test name="Product add and edit">
        <classes>
            <class name="com.anhtester.testcases.ProductTest">
                <methods>
                    <include name="testAddProduct"/>
                    <include name="testEditProduct"/>
                </methods>
            </class>
            <class name="com.anhtester.testcases.CategoryTest">
                <methods>
                    <include name="testAddCategory"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
