<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Suite chính: Login, Brand, Category, Product (Extent + Allure report) -->
<suite name="eCommerce Regression Suite" verbose="1">
    <!-- TestListener đã được khai báo bằng @Listeners ở BaseTest -->
    <test name="Regression - Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.anhtester.testcases.LoginTest"/>
            <class name="com.anhtester.testcases.BrandTest"/>
            <class name="com.anhtester.testcases.CategoryTest"/>
            <class name="com.anhtester.testcases.ProductTest"/>
        </classes>
    </test>
</suite>
