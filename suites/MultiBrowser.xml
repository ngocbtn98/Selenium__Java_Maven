<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- BT8: chạy song song nhiều browser. mvn clean test -DsuiteXmlFile=suites/MultiBrowser.xml -->
<suite name="Multi Browser" parallel="tests" thread-count="2" verbose="1">
    <test name="Login - Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.anhtester.testcases.LoginTest"/>
        </classes>
    </test>
    <test name="Login - Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.anhtester.testcases.LoginTest"/>
        </classes>
    </test>
</suite>
